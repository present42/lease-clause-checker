# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
# Only needed for live runs (baseline / pipeline / check). Tests and re-scoring need no keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional. Set it to send Gemini calls to Vertex AI in this project (needed for keys whose
# credit pays for Vertex AI only). Leave it empty to use the Gemini API.
GOOGLE_CLOUD_PROJECT=
